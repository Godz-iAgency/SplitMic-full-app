NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by admin moderation. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Site origin used to build links in outgoing emails. Defaults to
# https://splitmic.com if unset — only needed locally to get localhost links.
NEXT_PUBLIC_APP_URL=

# Resend (notification + support emails). Without this, emails are skipped
# (notifications) or the support form fails (support), logged, not thrown.
RESEND_API_KEY=
# Sender for user notification emails. Until splitmic.com is verified as a
# sending domain in Resend, leave unset — it falls back to a Resend shared
# address that only reliably delivers to the account owner's own inbox.
NOTIFY_FROM_EMAIL=
# Sender for the support form. Same domain-verification caveat as above.
SUPPORT_FROM_EMAIL=

# Gemini (AI show-matching for talent buyers). Requires the Generative
# Language API enabled on the Google Cloud project the key belongs to.
GEMINI_API_KEY=
