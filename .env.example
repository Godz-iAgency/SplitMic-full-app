NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by admin moderation. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Site origin used to build links in outgoing emails. Defaults to
# https://splitmic.com if unset — only needed locally to get localhost links.
NEXT_PUBLIC_APP_URL=

# Resend (notification + support emails). Without this, emails are skipped
# (notifications) or the support form fails (support), logged, not thrown.
RESEND_API_KEY=
# Sender for user notification emails. Until splitmic.com is verified as a
# sending domain in Resend, leave unset — it falls back to a Resend shared
# address that only reliably delivers to the account owner's own inbox.
NOTIFY_FROM_EMAIL=
# Sender for the support form. Same domain-verification caveat as above.
SUPPORT_FROM_EMAIL=

# Gemini (AI show-matching for talent buyers). Requires the Generative
# Language API enabled on the Google Cloud project the key belongs to.
GEMINI_API_KEY=

# Firecrawl. Used by two things: the Do512 scrape behind /live's daily sync
# job, and the directory listing screenshots run from /admin/directory. Both
# refuse to run without it rather than failing row by row. Get a key at
# https://firecrawl.dev.
FIRECRAWL_API_KEY=

# Ticketmaster Discovery API — the second /live event provider, alongside
# Do512. Server-only; never expose this to the frontend. Without it,
# /api/cron/sync-ticketmaster fails closed with a clear error and touches
# nothing — Do512 events keep working either way. Free tier: 5000 calls/day,
# 5/sec, plenty for a sync every ~4h. Get a key at
# https://developer.ticketmaster.com.
TICKETMASTER_API_KEY=

# Shared secret for scheduled endpoints — /api/cron/cleanup-posts,
# /api/cron/sync-events, and /api/cron/sync-ticketmaster (sent as
# "Authorization: Bearer <secret>"). Generate with: openssl rand -hex 32
# Leave unset and every endpoint refuses to run at all — none ever run open.
CRON_SECRET=
